{
  "name": "saturno-fancy-comments",
  "displayName": "Saturno FancyComments",
  "description": "Insert formatted single-line and multi-line comment separators",
  "publisher": "SaturnoSoftware",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaturnoSoftware/vscode-fancy-comments.git"
  },
  "bugs": {
    "url": "https://github.com/SaturnoSoftware/vscode-fancy-comments/issues"
  },
  "homepage": "https://github.com/SaturnoSoftware/vscode-fancy-comments#readme",
  "main": "./out/src/extension.js",
  "icon": "res/images/icon.png",
  "version": "3.0.0",
  "build": 25,
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "comment",
    "separator",
    "section",
    "banner",
    "divider",
    "formatting",
    "productivity",
    "toggle",
    "multiline",
    "documentation"
  ],
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "saturno-fancy-comments.singleLineComment",
        "title": "Saturno: Single Line Comment"
      },
      {
        "command": "saturno-fancy-comments.multiLineComment",
        "title": "Saturno: Multi Line Comment"
      },
      {
        "command": "saturno-fancy-comments.about",
        "title": "Saturno: About FancyComments"
      }
    ],
    "configuration": {
      "title": "Saturno FancyComments",
      "properties": {
        "saturno-fancy-comments.lineWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "maximum": 200,
          "description": "Total width of generated comment lines."
        },
        "saturno-fancy-comments.separatorChar": {
          "type": "string",
          "default": "-",
          "minLength": 1,
          "maxLength": 1,
          "description": "Character used to fill separator lines."
        },
        "saturno-fancy-comments.separatorPrefixLength": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 20,
          "description": "Number of separator characters before the text."
        },
        "saturno-fancy-comments.commentImplementation": {
          "type": "string",
          "enum": [
            "vscode",
            "syntax"
          ],
          "default": "vscode",
          "description": "Choose whether FancyComments uses VS Code's built-in comment commands or the internal syntax resolver."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src libs --ext ts",
    "test": "npm run compile && tsc -p tests/tsconfig.json && node --test out/tests/*.test.js",
    "build": "npm run lint && npm run compile && pwsh -NoLogo -NoProfile -File ./Scripts/build.ps1 -ProjectRoot . -BuildOutputDir __BUILD/_staging",
    "package": "pwsh -NoLogo -NoProfile -File ./Scripts/package-vsix.ps1",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "vsce": {
    "baseImagesUrl": "https://raw.githubusercontent.com/SaturnoSoftware/vscode-fancy-comments/main/"
  },
  "saturno": {
    "cicd": {
      "artifactPrefix": "Saturno.VSCode.FancyComments",
      "build": {
        "stagingRoot": "__BUILD/_staging",
        "expectedFiles": [
          "package.json",
          "out/src/extension.js"
        ],
        "expectedDirectories": [
          "out/libs"
        ]
      },
      "release": {
        "assets": [
          "*.vsix"
        ]
      }
    }
  }
}
